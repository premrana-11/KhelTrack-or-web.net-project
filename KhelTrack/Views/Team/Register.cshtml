@model KhelTrack.Models.ViewModels.TeamRegistrationViewModel
@{
    ViewData["Title"] = "Register Team & Submit Roster";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-10">
        <div class="khel-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-white mb-1"><i class="bi bi-shield-plus text-warning me-2"></i>Register Team & Roster</h3>
                    <p class="text-secondary small mb-0">Submit your departmental team entry and squad athlete verification for committee approval.</p>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-khel-outline">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
            </div>

            <form asp-action="Register" method="post" id="registrationForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <!-- Section 1: Team & Tournament Information -->
                <div class="p-3 mb-4 rounded bg-dark border border-secondary border-opacity-25">
                    <h5 class="fw-bold text-info mb-3"><i class="bi bi-info-circle me-1"></i> 1. Team & Tournament Details</h5>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TournamentId" class="form-label-khel"></label>
                            <select asp-for="TournamentId" asp-items="ViewBag.Tournaments" class="form-select form-khel-control"></select>
                            <span asp-validation-for="TournamentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TeamName" class="form-label-khel"></label>
                            <input asp-for="TeamName" class="form-control form-khel-control" placeholder="e.g. CS Cyber Knights" />
                            <span asp-validation-for="TeamName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label-khel"></label>
                            <input asp-for="Department" class="form-control form-khel-control" placeholder="e.g. Computer Science & Engineering" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactPhone" class="form-label-khel"></label>
                            <input asp-for="ContactPhone" class="form-control form-khel-control" placeholder="e.g. +91 98765 43210" />
                            <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Player Squad Roster -->
                <div class="p-3 mb-4 rounded bg-dark border border-secondary border-opacity-25">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold text-info mb-0"><i class="bi bi-people me-1"></i> 2. Player Squad Roster</h5>
                            <span class="text-secondary small">Add all starting players and substitutes for this tournament.</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-khel-accent" onclick="addPlayerRow()">
                            <i class="bi bi-person-plus-fill me-1"></i> + Add Player
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-khel align-middle" id="playersTable">
                            <thead>
                                <tr>
                                    <th style="min-width: 170px;">Athlete Name <span class="text-danger">*</span></th>
                                    <th style="min-width: 130px;">Roll Number <span class="text-danger">*</span></th>
                                    <th style="min-width: 130px;">Department</th>
                                    <th style="width: 90px;">Jersey #</th>
                                    <th style="min-width: 130px;">Position / Role</th>
                                    <th style="min-width: 120px;">Contact</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="playerRowsContainer">
                                @if (Model.Players != null)
                                {
                                    for (int i = 0; i < Model.Players.Count; i++)
                                    {
                                        <tr class="player-row">
                                            <td>
                                                <input type="text" name="Players[@i].StudentName" value="@Model.Players[i].StudentName" class="form-control form-khel-control form-control-sm" placeholder="Student Name" required />
                                            </td>
                                            <td>
                                                <input type="text" name="Players[@i].RollNumber" value="@Model.Players[i].RollNumber" class="form-control form-khel-control form-control-sm" placeholder="e.g. CS-042" required />
                                            </td>
                                            <td>
                                                <input type="text" name="Players[@i].Department" value="@Model.Players[i].Department" class="form-control form-khel-control form-control-sm" placeholder="Department" />
                                            </td>
                                            <td>
                                                <input type="number" name="Players[@i].JerseyNumber" value="@Model.Players[i].JerseyNumber" class="form-control form-khel-control form-control-sm text-center" placeholder="10" />
                                            </td>
                                            <td>
                                                <input type="text" name="Players[@i].Position" value="@Model.Players[i].Position" class="form-control form-khel-control form-control-sm" placeholder="e.g. Captain" />
                                            </td>
                                            <td>
                                                <input type="text" name="Players[@i].ContactNumber" value="@Model.Players[i].ContactNumber" class="form-control form-khel-control form-control-sm" placeholder="Phone" />
                                            </td>
                                            <td class="text-center">
                                                @if (i > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger p-1" onclick="removeRow(this)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-khel-outline">Cancel</a>
                    <button type="submit" class="btn btn-khel-primary px-4 py-2 fw-bold">
                        <i class="bi bi-send-check me-1"></i> Submit Team for Approval
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var rowIndex = @(Model.Players?.Count ?? 0);

        function addPlayerRow() {
            var container = document.getElementById("playerRowsContainer");
            var tr = document.createElement("tr");
            tr.className = "player-row";
            tr.innerHTML = `
                <td>
                    <input type="text" name="Players[${rowIndex}].StudentName" class="form-control form-khel-control form-control-sm" placeholder="Student Name" required />
                </td>
                <td>
                    <input type="text" name="Players[${rowIndex}].RollNumber" class="form-control form-khel-control form-control-sm" placeholder="e.g. CS-099" required />
                </td>
                <td>
                    <input type="text" name="Players[${rowIndex}].Department" class="form-control form-khel-control form-control-sm" placeholder="Department" />
                </td>
                <td>
                    <input type="number" name="Players[${rowIndex}].JerseyNumber" class="form-control form-khel-control form-control-sm text-center" placeholder="7" />
                </td>
                <td>
                    <input type="text" name="Players[${rowIndex}].Position" class="form-control form-khel-control form-control-sm" placeholder="Role / Position" />
                </td>
                <td>
                    <input type="text" name="Players[${rowIndex}].ContactNumber" class="form-control form-khel-control form-control-sm" placeholder="Phone" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger p-1" onclick="removeRow(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            container.appendChild(tr);
            rowIndex++;
        }

        function removeRow(btn) {
            var row = btn.closest("tr");
            row.remove();
            reindexRows();
        }

        function reindexRows() {
            var rows = document.querySelectorAll("#playerRowsContainer tr");
            rows.forEach((r, idx) => {
                r.querySelectorAll("input").forEach(input => {
                    var name = input.getAttribute("name");
                    if (name) {
                        var updated = name.replace(/Players\[\d+\]/, `Players[${idx}]`);
                        input.setAttribute("name", updated);
                    }
                });
            });
            rowIndex = rows.length;
        }
    </script>
}
