@model IEnumerable<KhelTrack.Models.Team>
@{
    ViewData["Title"] = "College Athletic Teams";
    var tournaments = ViewBag.Tournaments as List<KhelTrack.Models.Tournament>;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-1"><i class="bi bi-people-fill me-2 text-success"></i>Participating Teams</h2>
        <p class="text-secondary mb-0">Browse all collegiate sports teams, captains, and verified rosters across departments.</p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Register" class="btn btn-khel-accent">
            <i class="bi bi-plus-lg me-1"></i> Register New Team
        </a>
    }
</div>

<!-- Search & Filter Bar -->
<div class="khel-card p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-khel-control" placeholder="Search by team name, department, or captain..." />
            </div>
        </div>

        <div class="col-md-3">
            <select name="tournamentId" class="form-select form-khel-control" onchange="this.form.submit()">
                <option value="">-- All Tournaments --</option>
                @if (tournaments != null)
                {
                    foreach (var t in tournaments)
                    {
                        <!option value="@t.Id" @(ViewBag.SelectedTournamentId == t.Id ? "selected" : "")>@t.Name</!option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="status" class="form-select form-khel-control" onchange="this.form.submit()">
                <option value="">-- All Statuses --</option>
                <!option value="Approved" @(ViewBag.SelectedStatus?.ToString() == "Approved" ? "selected" : "")>Approved</!option>
                <!option value="Pending" @(ViewBag.SelectedStatus?.ToString() == "Pending" ? "selected" : "")>Pending Review</!option>
                <!option value="Rejected" @(ViewBag.SelectedStatus?.ToString() == "Rejected" ? "selected" : "")>Rejected</!option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-khel-primary w-100">
                Filter
            </button>
            <a asp-action="Index" class="btn btn-khel-outline">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

<!-- Teams Grid -->
<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var team in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="khel-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="khel-card-header d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary bg-opacity-25 text-light">
                                <i class="bi bi-building me-1"></i> @team.Department
                            </span>

                            @if (team.RegistrationStatus == KhelTrack.Models.TeamStatus.Approved)
                            {
                                <span class="badge badge-completed"><i class="bi bi-check-circle me-1"></i> Approved</span>
                            }
                            else if (team.RegistrationStatus == KhelTrack.Models.TeamStatus.Pending)
                            {
                                <span class="badge badge-pending"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                            }
                            else
                            {
                                <span class="badge badge-rejected"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                            }
                        </div>

                        <div class="p-3">
                            <h5 class="fw-bold text-white mb-1">@team.TeamName</h5>
                            <div class="text-secondary small mb-3">
                                <i class="bi bi-trophy text-warning me-1"></i> @team.Tournament?.Name (@team.Tournament?.SportType)
                            </div>

                            <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 small mb-2">
                                <div class="d-flex justify-content-between text-secondary mb-1">
                                    <span>Captain:</span>
                                    <span class="text-white fw-semibold">@(team.Captain?.FullName ?? "N/A")</span>
                                </div>
                                <div class="d-flex justify-content-between text-secondary mb-1">
                                    <span>Roster Size:</span>
                                    <span class="text-info fw-semibold">@team.Players.Count Registered Players</span>
                                </div>
                                <div class="d-flex justify-content-between text-secondary">
                                    <span>Registered On:</span>
                                    <span class="text-white">@team.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 pt-0 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@team.Id" class="btn btn-sm btn-khel-primary">
                            View Squad Details
                        </a>

                        @if (User.IsInRole("Admin") || (team.CaptainId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                        {
                            <a asp-action="ManageRoster" asp-route-id="@team.Id" class="btn btn-sm btn-khel-outline">
                                Manage Roster
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="khel-card p-5 text-center text-secondary">
                <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
                <h5>No Teams Found</h5>
                <p class="small">Try adjusting your filters or register a new team for an active tournament.</p>
                <a asp-action="Register" class="btn btn-sm btn-khel-accent mt-2">
                    Register a Team
                </a>
            </div>
        </div>
    }
</div>
