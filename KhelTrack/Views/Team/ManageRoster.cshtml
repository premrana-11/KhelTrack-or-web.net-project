@model KhelTrack.Models.Team
@{
    ViewData["Title"] = "Manage Roster - " + Model.TeamName;
    var addPlayerModel = ViewBag.AddPlayerModel as KhelTrack.Models.ViewModels.AddPlayerViewModel;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-1"><i class="bi bi-person-gear me-2 text-primary"></i>Manage Roster: @Model.TeamName</h2>
        <p class="text-secondary mb-0">Add or remove squad athletes for @Model.Tournament?.Name (@Model.Tournament?.SportType)</p>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-khel-accent" data-bs-toggle="modal" data-bs-target="#addPlayerModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add Athlete
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-khel-outline">
            Done & View Team
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="khel-card">
            <div class="khel-card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-white mb-0">Current Squad (@Model.Players.Count)</h5>
                <span class="text-secondary small">All changes logged to Campus Audit Trail</span>
            </div>

            <div class="table-responsive">
                <table class="table table-khel align-middle">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Jersey</th>
                            <th>Student Name</th>
                            <th>Roll Number</th>
                            <th>Department</th>
                            <th>Position</th>
                            <th class="text-end" style="width: 100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Players.Any())
                        {
                            foreach (var player in Model.Players.OrderBy(p => p.JerseyNumber ?? 999))
                            {
                                <tr>
                                    <td>
                                        <span class="badge rounded-circle bg-dark border border-secondary text-warning fw-bold d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                            @(player.JerseyNumber.HasValue ? player.JerseyNumber.Value.ToString() : "-")
                                        </span>
                                    </td>
                                    <td><strong class="text-white">@player.StudentName</strong></td>
                                    <td><span class="badge bg-secondary bg-opacity-25 text-light font-monospace">@player.RollNumber</span></td>
                                    <td>@player.Department</td>
                                    <td><span class="text-info">@(string.IsNullOrEmpty(player.Position) ? "-" : player.Position)</span></td>
                                    <td class="text-end">
                                        <form asp-action="RemovePlayer" asp-route-id="@player.Id" method="post" onsubmit="return confirm('Remove athlete @player.StudentName from the team roster?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger p-1 px-2" title="Remove Player">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-secondary">
                                    No players registered yet. Click "Add Athlete" to populate the squad.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Add Sidebar -->
    <div class="col-lg-4">
        <div class="khel-card p-4">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-plus-circle text-success me-2"></i>Quick Add Athlete</h5>
            <form asp-action="AddPlayer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TeamId" value="@Model.Id" />
                <input type="hidden" name="TeamName" value="@Model.TeamName" />

                <div class="mb-3">
                    <label class="form-label-khel">Student Full Name <span class="text-danger">*</span></label>
                    <input type="text" name="StudentName" class="form-control form-khel-control" placeholder="e.g. Yash Sharma" required />
                </div>

                <div class="mb-3">
                    <label class="form-label-khel">College Roll Number <span class="text-danger">*</span></label>
                    <input type="text" name="RollNumber" class="form-control form-khel-control" placeholder="e.g. CS2024-088" required />
                </div>

                <div class="mb-3">
                    <label class="form-label-khel">Department <span class="text-danger">*</span></label>
                    <input type="text" name="Department" value="@Model.Department" class="form-control form-khel-control" required />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label-khel">Jersey #</label>
                        <input type="number" name="JerseyNumber" class="form-control form-khel-control" placeholder="10" />
                    </div>
                    <div class="col-6">
                        <label class="form-label-khel">Role / Position</label>
                        <input type="text" name="Position" class="form-control form-khel-control" placeholder="Forward" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-khel">Contact Number</label>
                    <input type="text" name="ContactNumber" class="form-control form-khel-control" placeholder="Optional" />
                </div>

                <button type="submit" class="btn btn-khel-primary w-100">
                    <i class="bi bi-plus-lg me-1"></i> Add to Team Roster
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Add Player -->
<div class="modal fade" id="addPlayerModal" tabindex="-1" aria-labelledby="addPlayerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="addPlayerModalLabel"><i class="bi bi-person-plus text-success me-2"></i>Add Athlete to @Model.TeamName</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddPlayer" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TeamId" value="@Model.Id" />
                    <input type="hidden" name="TeamName" value="@Model.TeamName" />

                    <div class="mb-3">
                        <label class="form-label-khel">Student Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="StudentName" class="form-control form-khel-control" placeholder="e.g. Yash Sharma" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-khel">College Roll Number <span class="text-danger">*</span></label>
                        <input type="text" name="RollNumber" class="form-control form-khel-control" placeholder="e.g. CS2024-088" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-khel">Department <span class="text-danger">*</span></label>
                        <input type="text" name="Department" value="@Model.Department" class="form-control form-khel-control" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label-khel">Jersey #</label>
                            <input type="number" name="JerseyNumber" class="form-control form-khel-control" placeholder="10" />
                        </div>
                        <div class="col-6">
                            <label class="form-label-khel">Role / Position</label>
                            <input type="text" name="Position" class="form-control form-khel-control" placeholder="Striker" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-khel">Contact Number</label>
                        <input type="text" name="ContactNumber" class="form-control form-khel-control" placeholder="Optional" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-khel-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-khel-primary">Save Athlete</button>
                </div>
            </form>
        </div>
    </div>
</div>
