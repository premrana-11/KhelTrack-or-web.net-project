@model KhelTrack.Models.Tournament
@{
    ViewData["Title"] = "Edit " + Model.Name;
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="khel-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-white mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Tournament</h3>
                    <p class="text-secondary small mb-0">Modify details, dates, status, or guidelines for @Model.Name</p>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-khel-outline">
                    <i class="bi bi-arrow-left me-1"></i> Back to Hub
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label-khel"></label>
                        <input asp-for="Name" class="form-control form-khel-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SportType" class="form-label-khel"></label>
                        <input asp-for="SportType" class="form-control form-khel-control" />
                        <span asp-validation-for="SportType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label-khel"></label>
                    <textarea asp-for="Description" rows="2" class="form-control form-khel-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Rules" class="form-label-khel"></label>
                    <textarea asp-for="Rules" rows="3" class="form-control form-khel-control"></textarea>
                    <span asp-validation-for="Rules" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label-khel"></label>
                        <input asp-for="StartDate" type="date" class="form-control form-khel-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label-khel"></label>
                        <input asp-for="EndDate" type="date" class="form-control form-khel-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Venue" class="form-label-khel"></label>
                        <input asp-for="Venue" class="form-control form-khel-control" />
                        <span asp-validation-for="Venue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MaxTeams" class="form-label-khel"></label>
                        <input asp-for="MaxTeams" type="number" min="2" max="64" class="form-control form-khel-control" />
                        <span asp-validation-for="MaxTeams" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Status" class="form-label-khel"></label>
                        <select asp-for="Status" class="form-select form-khel-control">
                            <option value="Upcoming">Upcoming</option>
                            <option value="Active">Active</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-khel-outline">Cancel</a>
                    <button type="submit" class="btn btn-khel-primary px-4 fw-bold">
                        <i class="bi bi-save me-1"></i> Update Tournament
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
