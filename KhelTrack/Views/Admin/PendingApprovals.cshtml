@model IEnumerable<KhelTrack.Models.Team>
@{
    ViewData["Title"] = "Pending Team Registrations Review";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-1"><i class="bi bi-check2-circle me-2 text-warning"></i>Team Registration Approvals</h2>
        <p class="text-secondary mb-0">Inspect submitted rosters, verify athlete student IDs, and approve or reject entries.</p>
    </div>

    <a asp-action="Dashboard" class="btn btn-khel-outline">
        <i class="bi bi-arrow-left me-1"></i> Admin Dashboard
    </a>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var team in Model)
        {
            <div class="col-12">
                <div class="khel-card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h4 class="fw-bold text-white mb-0">@team.TeamName</h4>
                                <span class="badge badge-pending">Pending Review</span>
                            </div>
                            <span class="text-secondary small">
                                <i class="bi bi-trophy text-warning me-1"></i> @team.Tournament?.Name (@team.Tournament?.SportType) &bull;
                                Dept: <strong class="text-white">@team.Department</strong> &bull;
                                Submitted: <strong class="text-white">@team.CreatedAt.ToString("g")</strong>
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <form asp-action="ApproveTeam" asp-route-id="@team.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success fw-semibold">
                                    <i class="bi bi-check-lg me-1"></i> Approve Team
                                </button>
                            </form>

                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@team.Id">
                                <i class="bi bi-x-lg me-1"></i> Reject
                            </button>
                        </div>
                    </div>

                    <!-- Captain & Contact Metadata -->
                    <div class="p-3 mb-3 rounded bg-dark border border-secondary border-opacity-25 small">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <span class="text-secondary d-block">Captain Name:</span>
                                <span class="text-white fw-bold">@(team.Captain?.FullName ?? "N/A")</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-secondary d-block">Captain Email & Roll No:</span>
                                <span class="text-white">@team.Captain?.Email (@(team.Captain?.CollegeRollNo ?? "N/A"))</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-secondary d-block">Contact Phone:</span>
                                <span class="text-white">@team.ContactPhone</span>
                            </div>
                        </div>
                    </div>

                    <!-- Submitted Roster Accordion / Table -->
                    <div class="border border-secondary border-opacity-25 rounded overflow-hidden">
                        <div class="p-2 px-3 bg-dark bg-opacity-75 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-info small"><i class="bi bi-people me-1"></i> Submitted Athlete Roster (@team.Players.Count Players)</span>
                            <span class="text-muted small">Verify college roll numbers before approval</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-khel align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 70px;">Jersey</th>
                                        <th>Athlete Name</th>
                                        <th>Roll Number</th>
                                        <th>Department</th>
                                        <th>Position</th>
                                        <th>Contact</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in team.Players.OrderBy(p => p.JerseyNumber ?? 999))
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge rounded-circle bg-dark border border-secondary text-warning fw-bold d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                                    @(p.JerseyNumber.HasValue ? p.JerseyNumber.Value.ToString() : "-")
                                                </span>
                                            </td>
                                            <td class="text-white fw-semibold">@p.StudentName</td>
                                            <td><span class="badge bg-secondary bg-opacity-25 text-light font-monospace">@p.RollNumber</span></td>
                                            <td>@p.Department</td>
                                            <td><span class="text-info">@p.Position</span></td>
                                            <td class="text-secondary small">@(string.IsNullOrEmpty(p.ContactNumber) ? "-" : p.ContactNumber)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Rejection Modal -->
                <div class="modal fade" id="rejectModal-@team.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@team.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content bg-dark border-secondary text-white">
                            <div class="modal-header border-secondary">
                                <h5 class="modal-title text-danger" id="rejectModalLabel-@team.Id">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Reject Team Registration
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="RejectTeam" asp-route-id="@team.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-body">
                                    <p class="small text-secondary">
                                        Please provide the rationale for rejecting <strong>@team.TeamName</strong>. The captain will view this feedback on their dashboard.
                                    </p>
                                    <div class="mb-3">
                                        <label class="form-label-khel">Feedback / Rejection Reason</label>
                                        <textarea name="reason" rows="3" class="form-control form-khel-control" placeholder="e.g. Ineligible players listed outside department, invalid student roll numbers, or incomplete squad..."></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-khel-outline" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="khel-card p-5 text-center text-secondary">
                <i class="bi bi-check-circle-fill fs-1 text-success d-block mb-3"></i>
                <h5>All Registrations Processed</h5>
                <p class="small">There are no pending team applications awaiting sports committee review.</p>
                <a asp-action="Dashboard" class="btn btn-sm btn-khel-primary mt-2">
                    Return to Dashboard
                </a>
            </div>
        </div>
    }
</div>
