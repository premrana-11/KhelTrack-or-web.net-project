@model List<KhelTrack.Models.ViewModels.TournamentLeaderboardItem>
@{
    ViewData["Title"] = "Tournament Points Table & Leaderboard";
    var tournaments = ViewBag.Tournaments as List<KhelTrack.Models.Tournament>;
    var selectedTournament = ViewBag.SelectedTournament as KhelTrack.Models.Tournament;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-1">
            <i class="bi bi-bar-chart-line-fill me-2 text-danger"></i>Points Table & Standings
        </h2>
        <p class="text-secondary mb-0">Live collegiate tournament standings, match statistics, win/loss records, and points.</p>
    </div>

    @if (selectedTournament != null)
    {
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 fs-6 px-3 py-2">
                <i class="bi bi-trophy me-1"></i> @selectedTournament.SportType: @selectedTournament.Name
            </span>
        </div>
    }
</div>

<!-- Tournament Selector -->
<div class="khel-card p-3 mb-4">
    <form asp-controller="Home" asp-action="Leaderboard" method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <label class="form-label-khel">Select Tournament</label>
            <select name="tournamentId" class="form-select form-khel-control" onchange="this.form.submit()">
                @if (tournaments != null)
                {
                    foreach (var t in tournaments)
                    {
                        <!option value="@t.Id" @(ViewBag.SelectedTournamentId == t.Id ? "selected" : "")>
                            @t.Name (@t.SportType - @t.Status)
                        </!option>
                    }
                }
            </select>
        </div>
        <div class="col-md-6 text-md-end pt-md-4">
            <span class="text-secondary small">
                <i class="bi bi-info-circle me-1"></i> Scoring: Win = 2 Pts, Draw/Tie = 1 Pt, Loss = 0 Pts
            </span>
        </div>
    </form>
</div>

<!-- Standings Table -->
<div class="khel-card">
    <div class="table-responsive">
        <table class="table table-khel align-middle">
            <thead>
                <tr>
                    <th style="width: 70px;">Rank</th>
                    <th>Team</th>
                    <th>Department</th>
                    <th class="text-center">Played</th>
                    <th class="text-center">Won</th>
                    <th class="text-center">Lost</th>
                    <th class="text-center">Drawn</th>
                    <th class="text-center">Form Guide</th>
                    <th class="text-center">Points</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int rank = 1;
                    foreach (var row in Model)
                    {
                        <tr>
                            <td>
                                @if (rank == 1)
                                {
                                    <span class="badge rounded-circle bg-warning text-dark fw-bold d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">1</span>
                                }
                                else if (rank == 2)
                                {
                                    <span class="badge rounded-circle bg-secondary text-light fw-bold d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">2</span>
                                }
                                else if (rank == 3)
                                {
                                    <span class="badge rounded-circle bg-danger text-light fw-bold d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">3</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-secondary ps-2">@rank</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Team" asp-action="Details" asp-route-id="@row.TeamId" class="text-white text-decoration-none fw-bold hover-info">
                                    @row.TeamName
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-dark border border-secondary text-secondary">@row.Department</span>
                            </td>
                            <td class="text-center fw-semibold">@row.MatchesPlayed</td>
                            <td class="text-center text-success fw-bold">@row.Won</td>
                            <td class="text-center text-danger">@row.Lost</td>
                            <td class="text-center text-secondary">@row.Drawn</td>
                            <td class="text-center">
                                @if (row.Form != "-")
                                {
                                    var forms = row.Form.Split('-');
                                    foreach (var f in forms)
                                    {
                                        if (f == "W")
                                        {
                                            <span class="badge bg-success p-1 rounded-circle" style="font-size: 0.65rem; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center;">W</span>
                                        }
                                        else if (f == "L")
                                        {
                                            <span class="badge bg-danger p-1 rounded-circle" style="font-size: 0.65rem; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center;">L</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary p-1 rounded-circle" style="font-size: 0.65rem; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center;">D</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 fs-6 fw-bold px-3 py-1">
                                    @row.Points
                                </span>
                            </td>
                        </tr>
                        rank++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-secondary">
                            <i class="bi bi-clipboard-x fs-1 text-muted d-block mb-2"></i>
                            No approved teams or matches recorded for this tournament yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
