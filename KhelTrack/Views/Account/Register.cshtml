@model KhelTrack.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="khel-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-icon-box mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Join KhelTrack</h3>
                <p class="text-secondary small">Create your student or team captain account for campus athletic tournaments.</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label-khel"></label>
                        <input asp-for="FullName" class="form-control form-khel-control" placeholder="e.g. Aarav Patel" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CollegeRollNo" class="form-label-khel"></label>
                        <input asp-for="CollegeRollNo" class="form-control form-khel-control" placeholder="e.g. CS2024-055" />
                        <span asp-validation-for="CollegeRollNo" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label-khel"></label>
                        <input asp-for="Department" class="form-control form-khel-control" placeholder="e.g. Computer Science" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label-khel"></label>
                        <select asp-for="Role" class="form-select form-khel-control">
                            <option value="Captain">Team Captain (Can Register Teams)</option>
                            <option value="Student">Student / Spectator</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label-khel"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control form-khel-control" placeholder="name@college.edu" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label-khel"></label>
                        <input asp-for="Password" class="form-control form-khel-control" placeholder="At least 6 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label-khel"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-khel-control" placeholder="Repeat password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-khel-accent w-100 py-2 fs-6 fw-bold">
                    <i class="bi bi-check2-circle me-1"></i> Complete Registration
                </button>
            </form>

            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center text-secondary small">
                Already registered?
                <a asp-action="Login" class="text-warning text-decoration-none fw-semibold ms-1">Log in here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
